    "scripts":  {
                    "dev":  "next dev --webpack -H 0.0.0.0",
                    "build":  "next build",
                    "start":  "next start -H 0.0.0.0",
                    "release:check":  "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm run build",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint .",
                    "lint:fix":  "eslint . --fix",
                    "clean:ui": "eslint app components --fix || true",
                    "db:seed":  "tsx lib/db/seed.ts",
