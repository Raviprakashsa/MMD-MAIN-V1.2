# MMDSS environment configuration
# Copy to .env.local for development or configure these values in your hosting platform.

# Database
DATABASE_URL="mongodb://localhost:27017/mmdss"
# DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/mmdss"

# Application URLs
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# Required production secrets
# Generate strong random values before deployment.
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_SECRET="replace-with-the-same-or-another-strong-random-secret"
CRON_SECRET="replace-with-a-strong-random-bearer-token"
DOCUMENT_DOWNLOAD_SECRET="replace-with-a-strong-random-signing-secret"

# Demo/dev UI controls
# Keep false in production. Use the seed script or admin UI to create real users.
NEXT_PUBLIC_SHOW_TEST_ACCOUNTS="false"

# Optional feature flags
FEATURE_MANAGED_DOCUMENT_STORAGE="true"
FEATURE_CANDIDATE_JOINED_TXN="true"
FEATURE_SEARCH_RBAC_STRICT_MODE="true"

# Optional dashboard thresholds
DASHBOARD_STALLED_DAYS="15"
DASHBOARD_RECENT_ACTIVITY_DAYS="7"
DASHBOARD_IDLE_ACTIVITY_HOURS="48"
DASHBOARD_MOU_EXPIRY_DAYS="30"
DASHBOARD_OFFER_STUCK_DAYS="14"
DASHBOARD_RED_ZONE_RECENCY_DAYS="7"

# Optional audit smoke-test credentials
AUDIT_EMAIL=""
AUDIT_PASSWORD=""
